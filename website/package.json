{
  "name": "production-data-analysis",
  "version": "1.0.0",
  "description": "Production Data Analysis website for the assembly production department (defects, compliance, safety).",
  "main": "server/index.js",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "demo": "node -e \"process.env.PDA_DB='data/demo.db';process.env.PDA_ALLOW_GUEST='1';process.env.PORT=process.env.PORT||'8081';require('./server/index.js')\"",
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "node scripts/check-samples.js",
    "seed": "node scripts/seed.js",
    "load-samples": "node scripts/load-samples.js",
    "backup": "node scripts/backup-now.js",
    "restore": "node scripts/restore.js",
    "snapshot": "node scripts/snapshot.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@huggingface/hub": "^1.1.2",
    "compression": "^1.7.5",
    "echarts": "^5.6.0",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "multer": "^1.4.5-lts.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
